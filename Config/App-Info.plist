<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged with the generated Info.plist (GENERATE_INFOPLIST_FILE = YES).
	     Value comes from UNSPLASH_ACCESS_KEY in Config/App.xcconfig / Secrets.xcconfig.
	     Access key only; the Unsplash secret key never ships in the app. -->
	<key>UnsplashAccessKey</key>
	<string>$(UNSPLASH_ACCESS_KEY)</string>
</dict>
</plist>

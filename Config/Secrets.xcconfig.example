// Copy to Config/Secrets.xcconfig (gitignored), or run scripts/sync-secrets.sh
// to generate it from .env.
//
// Only the Unsplash ACCESS key belongs here. It is the public "Client-ID"
// credential used for search. Never put the Unsplash SECRET key in this file or
// anywhere in the app target.
UNSPLASH_ACCESS_KEY = your-unsplash-access-key
